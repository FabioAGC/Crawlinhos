# Copie para .env e preencha. Sem credenciais, a fonte correspondente é pulada (status NO_CREDENTIALS).
# Formato: CHAVE=valor, sem aspas e sem comentário na mesma linha.

# Amazon Associados — https://associados.amazon.com.br (ID de rastreamento, ex.: minhaloja-20)
AMAZON_TAG=

# Mercado Livre — app em https://developers.mercadolivre.com.br (DevCenter) + programa de afiliados
# Forma recomendada (renova sozinho; access_token dura 6h e a coleta é diária):
#   ML_CLIENT_ID / ML_CLIENT_SECRET = "ID do aplicativo" e "Chave secreta" do app
#   ML_REFRESH_TOKEN = refresh_token recebido na 1ª autorização (grant_type=authorization_code;
#                      o app precisa do escopo offline_access). É de uso único: a cada renovação o
#                      novo valor é gravado em data/ml-token.json (não apague nem versione esse arquivo).
#                      Se reautorizar o app, basta trocar o valor aqui.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
# Alternativa para teste manual: access_token direto (expira em 6h, sem renovação).
ML_ACCESS_TOKEN=
# Busca: auto (padrão: /sites/MLB/search e, se 403, catálogo) | items | catalog
ML_SEARCH_MODE=auto
# Onde guardar o token renovado (padrão: data/ml-token.json)
#ML_TOKEN_FILE=
# Modelo do link de afiliado. {url} = URL do produto sem query; {url_enc} = a mesma, url-encoded.
# Copie o formato de um link gerado no painel de afiliados e troque SEU_TOOL_ID.
# Enquanto contiver SEU_TOOL_ID, os links saem sem comissão (tagged=false).
ML_AFFILIATE_TEMPLATE={url}?matt_tool=SEU_TOOL_ID&matt_word=radar

# Shopee Affiliate Open API — https://affiliate.shopee.com.br/open_api (AppID e Senha/Secret)
# O link de afiliado (offerLink) vem pronto da API; não há variável de link.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Magalu — Parceiro Magalu (Magazine Você): nome da sua loja em magazinevoce.com.br/magazine{LOJA}
# (só o nome, sem "magazine" na frente). A coleta lê a página pública e é bloqueada (403) em IP de datacenter.
MAGALU_STORE=

# Quais fontes rodar e quantos itens por busca
SOURCES=amazon,mercadolivre,shopee,magalu
LIMIT_PER_QUERY=12
PORT=8080
